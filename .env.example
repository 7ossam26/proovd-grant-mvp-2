# Proovd MVP — environment contract (tech-stack-v2 §17, per Spec §32.2).
# This file documents variable NAMES and non-secret shape only.
# Real keys/secrets live in Dokploy's environment configuration or a secrets
# manager — never in the repo, the frontend bundle, email, or documentation
# (tech-stack-v2 §16). The app fails closed on any mode or context mismatch.

NODE_ENV=development
PORT=3000
APP_BASE_URL=https://app.proovd.co
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/proovd

# Integration tests — set to avoid Testcontainers when Docker is unavailable.
# Testcontainers is used automatically when this is unset.
TEST_DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/proovd_test

STRIPE_MODE=test
STRIPE_API_VERSION=[LOCKED VERSION]
STRIPE_PLATFORM_ACCOUNT_ID=acct_...
STRIPE_PLATFORM_SECRET_KEY=sk_test_...
STRIPE_PLATFORM_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET_PLATFORM=whsec_...
STRIPE_WEBHOOK_SECRET_CONNECT=whsec_...
STRIPE_CONNECT_RETURN_URL=https://app.proovd.co/stripe/return
STRIPE_CONNECT_REFRESH_URL=https://app.proovd.co/stripe/refresh
STRIPE_TEST_FOUNDER_CONNECTED_ACCOUNT_ID=acct_...
STRIPE_TEST_AFFILIATE_CONNECTED_ACCOUNT_ID=acct_...
STRIPE_TEST_BACKUP_MODE_ENABLED=false
STRIPE_TAX_ENABLED=true

# Signs Better Auth sessions and password-reset links. Required, >= 32 chars.
BETTER_AUTH_SECRET=

# Founder-only Google sign-in (Spec §5.2). Optional, but all-or-nothing —
# a client ID without its secret fails at the redirect, not at boot, so the
# env guard rejects a half-configured pair.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spec §6 Admin setting: "Admin MFA and reauthentication window", in seconds.
# Required, and deliberately WITHOUT a default — §6 names the setting and fixes
# no number, so the operator states it rather than the code inventing one.
# Governs the recent-reauthentication gate on money movement, refunds,
# connected-account actions, and campaign kill/suspend (§5.1, §28.2).
#
# From Phase 06 this is the FIRST-BOOT SEED, not the running value. The app
# writes it into the `admin_reauth_window_seconds` setting while that setting is
# still unset — an Admin cannot reach the settings surface before the app is
# running and guarded — and from then on the setting is authoritative and this
# variable is ignored. Changing it later does not change the window, and does
# not reset a window an Admin has chosen.
ADMIN_REAUTH_WINDOW_SECONDS=

# Transactional email (§27.2). Optional to boot: the app has to start before an
# Admin can look at the §6 prerequisites panel and see that it is missing. While
# either is blank, the transactional-email prerequisite is unsatisfied and the
# live-mode gate blocks — which is the honest state until a provider exists.
RESEND_API_KEY=
EMAIL_FROM=

# Object storage — Cloudflare R2 (tech-stack §9, Spec §12). Campaign visuals
# and brand assets are PUT straight from the browser to a presigned URL; no
# file ever touches this container's disk, and there is no upload route that
# would accept one.
#
# Optional to boot, and ALL FOUR OR NONE: three of the four presign a URL that
# R2 rejects, and the rejection reaches the browser as an opaque failure
# mid-upload. The app refuses to start on a half-configured bucket, and with
# none of them set the workspace says uploading is unavailable rather than
# reporting a file as stored when no bucket exists (§1.4).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# tech-stack §9: "W-9s and dispute packets are sensitive. Keep them in a
# separate bucket or prefix with its own lifecycle policy, and never issue a
# long-lived presigned URL for them." Nothing writes to it yet; it is declared
# now so the separation is configured before the phase that needs it.
R2_BUCKET_SENSITIVE=

CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=

TAWK_PROPERTY_ID=
SENTRY_DSN=
POSTHOG_KEY=

# ── Frontend build-time values (Spec §31.4, §30) ──────────────────────────────
# VITE_* names are baked into the client bundle, so nothing secret may appear
# here (§28.2). A Tawk property/widget ID is a public embed identifier.
#
# Live chat renders ONLY inside staffed hours and does not render at all
# outside them — not greyed out, not "we're away" (§31.4; §30 lists unstaffed
# live chat as a forbidden pattern). §31.4 names staffed hours as a setting and
# fixes no number, so there is DELIBERATELY NO DEFAULT: leave any of these four
# blank and no chat widget is rendered anywhere. The real commitment is the
# §27.8 one-business-day email SLA in the footer.
#
# Days are not configurable — Monday–Friday excluding U.S. federal holidays
# comes from the committed calendar in shared/calendar (§27.8, §29.6).
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=
# IANA zone the hours below are stated in, e.g. America/New_York
VITE_SUPPORT_CHAT_TIMEZONE=
# Staffed window on a U.S. business day, HH:MM-HH:MM, e.g. 09:00-17:00
VITE_SUPPORT_CHAT_HOURS=

CRON_SECRET=
US_HOLIDAY_CALENDAR_VERSION=
