<body>
  <div>
    <header
      class="site-header"
    >
      <a
        class="skip-link"
        href="#main"
      >
        Skip to the main content
      </a>
      <div
        class="site-header__inner"
      >
        <a
          class="site-header__brand"
          data-discover="true"
          href="/"
        >
          Proovd
        </a>
        <nav
          aria-label="Main"
          class="site-nav"
        >
          <a
            class="site-nav__link"
            data-discover="true"
            href="/about"
          >
            About Proovd
          </a>
          <a
            class="site-nav__link"
            data-discover="true"
            href="/how-payments-work"
          >
            How payments work
          </a>
          <a
            class="site-nav__link"
            data-discover="true"
            href="/safety"
          >
            Safety
          </a>
          <a
            class="site-nav__link"
            data-discover="true"
            href="/campaign/sample-pre-build"
          >
            See a sample campaign
          </a>
        </nav>
        <div
          class="site-header__account"
        >
          <a
            class="site-header__signin"
            data-discover="true"
            href="/signin"
          >
            Sign in
          </a>
        </div>
      </div>
    </header>
    <main
      id="main"
      tabindex="-1"
    >
      <div
        class="mode-light"
      >
        <section
          class="section section--breathe"
        >
          <div
            class="wrap"
          >
            <div
              class="measure"
            >
              <h1>
                We don’t have a page at this address
              </h1>
              <section
                aria-labelledby="_r_hp_"
                class="state-panel"
              >
                <p
                  class="state-panel__head"
                  id="_r_hp_"
                >
                  This address doesn’t match a page on Proovd
                </p>
                <dl
                  class="state-panel__rows"
                >
                  <div
                    class="state-panel__row"
                  >
                    <dt
                      class="state-panel__key"
                    >
                      What happened
                    </dt>
                    <dd
                      class="state-panel__val"
                    >
                      The link may be mistyped, or it may point at something that was never published here. 
                      <strong>
                        Nothing has been submitted and nothing has been charged.
                      </strong>
                    </dd>
                  </div>
                  <div
                    class="state-panel__row"
                  >
                    <dt
                      class="state-panel__key"
                    >
                      Next
                    </dt>
                    <dd
                      class="state-panel__val"
                    >
                      Start from the homepage, or use the links in the footer to go straight to what you were looking for.
                    </dd>
                  </div>
                  <div
                    class="state-panel__row"
                  >
                    <dt
                      class="state-panel__key"
                    >
                      Owner
                    </dt>
                    <dd
                      class="state-panel__val"
                    >
                      <span
                        class="tag tag--live"
                      >
                        You
                      </span>
                    </dd>
                  </div>
                  <div
                    class="state-panel__row"
                  >
                    <dt
                      class="state-panel__key"
                    >
                      Next update by
                    </dt>
                    <dd
                      class="state-panel__val"
                    >
                      No update is pending
                    </dd>
                  </div>
                  <div
                    class="state-panel__row"
                  >
                    <dt
                      class="state-panel__key"
                    >
                      Reference
                    </dt>
                    <dd
                      class="state-panel__val"
                    >
                      No campaign or account is identified by this address.
                    </dd>
                  </div>
                </dl>
                <div
                  class="state-panel__actions"
                >
                  <a
                    class="btn btn--primary"
                    href="/"
                  >
                    <span
                      class="btn__label"
                    >
                      Go to the Proovd homepage
                    </span>
                  </a>
                  <a
                    class="btn btn--tertiary"
                    href="mailto:support@proovd.co?subject=Broken%20link%20on%20app.proovd.co"
                  >
                    <span
                      class="btn__label"
                    >
                      <svg
                        aria-hidden="true"
                        class="pv-ico"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        viewBox="0 0 24 24"
                      >
                        <circle
                          cx="12"
                          cy="12"
                          r="9"
                        />
                        <path
                          d="M9.5 9.5a2.5 2.5 0 0 1 4.5 1.5c0 1.7-2.5 2-2.5 3.5"
                        />
                        <path
                          d="M12 17.5h.01"
                        />
                      </svg>
                      Get help
                    </span>
                  </a>
                </div>
              </section>
            </div>
          </div>
        </section>
      </div>
    </main>
    <footer
      aria-label="Site footer"
      class="site-footer mode-dark"
    >
      <div
        class="wrap site-footer__inner"
      >
        <section
          aria-labelledby="footer-contact-heading"
          class="site-footer__contact"
        >
          <h2
            class="site-footer__heading"
            id="footer-contact-heading"
          >
            Contact Proovd
          </h2>
          <p
            class="site-footer__line"
          >
            Email: 
            <a
              href="mailto:support@proovd.co"
            >
              support@proovd.co
            </a>
          </p>
          <p
            class="site-footer__line"
          >
            We respond within one (1) business day, Monday–Friday, excluding U.S. federal holidays.
          </p>
          <p
            class="site-footer__line"
          >
            Postal: Proovd LLC, 254 Chapman Rd, Ste 208 #27541, Newark, DE 19702, USA.
          </p>
        </section>
        <nav
          aria-labelledby="footer-legal-heading"
          class="site-footer__group"
        >
          <h2
            class="site-footer__heading"
            id="footer-legal-heading"
          >
            Policies and payments
          </h2>
          <ul
            class="site-footer__list"
          >
            <li>
              <a
                data-discover="true"
                href="/terms"
              >
                Terms of Service
              </a>
            </li>
            <li>
              <a
                data-discover="true"
                href="/privacy"
              >
                Privacy Policy
              </a>
            </li>
            <li>
              <a
                data-discover="true"
                href="/cookies"
              >
                Cookie Policy
              </a>
            </li>
            <li>
              <a
                data-discover="true"
                href="/refunds"
              >
                Refund Policy
              </a>
            </li>
            <li>
              <a
                data-discover="true"
                href="/fulfillment"
              >
                Fulfillment Policy
              </a>
            </li>
            <li>
              <a
                data-discover="true"
                href="/aup"
              >
                Founder Acceptable Use Policy
              </a>
            </li>
            <li>
              <a
                href="https://stripe.com/connect-account/legal"
                rel="noopener noreferrer"
                target="_blank"
              >
                Stripe Connected Account Agreement
                <span
                  class="pv-sr"
                >
                   (opens in a new tab)
                </span>
              </a>
            </li>
            <li>
              <a
                data-discover="true"
                href="/how-payments-work"
              >
                How payments work
              </a>
            </li>
            <li>
              <a
                data-discover="true"
                href="/safety"
              >
                Safety
              </a>
            </li>
          </ul>
        </nav>
        <nav
          aria-labelledby="footer-site-heading"
          class="site-footer__group"
        >
          <h2
            class="site-footer__heading"
            id="footer-site-heading"
          >
            Everything else on this site
          </h2>
          <ul
            class="site-footer__list"
          >
            <li>
              <a
                data-discover="true"
                href="/about"
              >
                About Proovd
              </a>
            </li>
            <li>
              <a
                data-discover="true"
                href="/affiliate-aup"
              >
                Creator Acceptable Use Policy
              </a>
            </li>
            <li>
              <a
                data-discover="true"
                href="/ip-agreement"
              >
                Creator IP and Confidentiality Agreement
              </a>
            </li>
            <li>
              <a
                data-discover="true"
                href="/campaign/sample-pre-build"
              >
                Sample Idea Campaign
              </a>
            </li>
            <li>
              <a
                data-discover="true"
                href="/campaign/sample-pre-launch"
              >
                Sample Product Campaign
              </a>
            </li>
          </ul>
        </nav>
      </div>
      <div
        class="wrap site-footer__legal"
      >
        <p
          class="site-footer__line"
        >
          Proovd LLC
           is a Delaware software platform. On every campaign, the Founder is the seller and the merchant of record; 
          Proovd LLC
           is the merchant of record only for the separate Founder listing fee.
        </p>
      </div>
    </footer>
  </div>
  <div
    class="pv-notices"
  >
